# Client: always use the relative path so the auth cookie stays same-site.
# - Local: Vite proxies /api → http://localhost:3000 (see vite.config.ts)
# - Vercel: vercel.json rewrites /api → your API host (see destination there)
VITE_API_BASE_URL=/api/v1

# Optional: where "Download the extension" points. Defaults to the latest
# GitHub release of echoes-browser-extension.
# VITE_EXTENSION_DOWNLOAD_URL=
