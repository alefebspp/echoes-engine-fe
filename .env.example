# Client: always use the relative path so the auth cookie stays same-site.
# - Local: Vite proxies /api → http://localhost:3000 (see vite.config.ts)
# - Vercel: api/[...path].ts proxies /api → API_ORIGIN
VITE_API_BASE_URL=/api/v1

# Server-only (Vercel). Origin of the Nest API — no /api/v1 suffix.
# Change this when the API host changes; no code deploy required beyond a redeploy.
# API_ORIGIN=https://echoes-engine.onrender.com
